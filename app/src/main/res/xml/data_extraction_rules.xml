<?xml version="1.0" encoding="utf-8"?>
<!--
   Journal entries, custom sites and voice memos stay on the device: nothing is backed up
   to the cloud or copied during device-to-device transfer.
   (android:allowBackup is also false in the manifest; this file covers Android 12 and newer.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
