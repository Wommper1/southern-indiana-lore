<?xml version="1.0" encoding="utf-8"?>
<!--
   Journal entries, custom sites and voice memos stay on the device: nothing is backed up.
   (android:allowBackup is also false in the manifest; this file covers Android 11 and older.)
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
